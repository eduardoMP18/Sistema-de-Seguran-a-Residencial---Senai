
#include <Servo.h>
#include <LiquidCrystal.h>
#include <Keypad.h>
//TEMPORIZADOR
unsigned long tempoMovimento = 0;
// LCD
const int RS = 2;
const int E = 3;
const int DB4 = 4;
const int DB5 = 5;
const int DB6 = 6;
const int DB7 = 7;

// SERVO
const int SERVO_PIN = A0;

// SENSOR E LED RGB
const int PIR = A5;
const int ALARM = A4;
const int RED_LED = A3;
const int BLUE_LED = A2;
const int GREEN_LED = A1;

// LED DA LAMPADA INTERNA
const int LED_LAMPADA = 1;

// ESTADOS DO SISTEMA
const int UNARMED = 0;
const int ARMED = 1;
const int ALARM_STATUS = 2;

int systemState = ARMED;
int pirState;

// LCD
LiquidCrystal lcd(RS, E, DB4, DB5, DB6, DB7);

// POSICOES DO SERVO
const int LOCKED_POS = 90;
const int UNLOCKED_POS = 0;

Servo servo;

// TECLADO
const byte ROWS = 3;
const byte COLS = 3;

const char KEYMAP[ROWS][COLS] = {
  {'1', '2', '3'},
  {'4', '5', '6'},
  {'7', '8', '9'}
};

const String CODE = "1235";

byte ROW_PINS[ROWS] = {13, 12, 11};
byte COL_PINS[COLS] = {10, 9, 8};

Keypad keypad = Keypad(
  makeKeymap(KEYMAP),
  ROW_PINS,
  COL_PINS,
  ROWS,
  COLS
);

// ENTRADA DA SENHA
String input = "";
char key;

// MENSAGEM DO LCD
String mensagemSenha = "";
String ultimaTela = "";

unsigned long tempoMensagem = 0;
const unsigned long TEMPO_MENSAGEM = 1200;

// TENTATIVAS
int failedAttempts = 0;

// ALARME
bool disarmScreen = false;
bool alarmeAtivo = false;

unsigned long tempoBuzzer = 0;
bool estadoBuzzer = false;

const unsigned long INTERVALO_BUZZER = 500;

// PORTA
unsigned long tempoAbertura = 0;
const unsigned long TEMPO_ABERTO = 5000;

bool portaAberta = false;

// CONTROLE DO SERVO
int ultimaPosicaoServo = -1;


// SETUP
void setup() {

  lcd.begin(16, 2);

  servo.attach(SERVO_PIN);

  pinMode(PIR, INPUT);
  pinMode(ALARM, OUTPUT);

  pinMode(RED_LED, OUTPUT);
  pinMode(GREEN_LED, OUTPUT);
  pinMode(BLUE_LED, OUTPUT);

  // LED DA LAMPADA
  pinMode(LED_LAMPADA, OUTPUT);
  digitalWrite(LED_LAMPADA, LOW);

  // INICIA COM A PORTA TRAVADA
  lockDoor();

  updateOutputs();
}


// LOOP
void loop() {

  readKeypad();

  readPIR();

  // FECHA A PORTA APOS 5 SEGUNDOS
  if (portaAberta &&
      millis() - tempoAbertura >= TEMPO_ABERTO) {

    portaAberta = false;
  }

  // APAGA A MENSAGEM APOS 1,2 SEGUNDOS
  if (mensagemSenha != "" &&
      millis() - tempoMensagem >= TEMPO_MENSAGEM) {

    mensagemSenha = "";
  }

  updateOutputs();
}


// LEITURA DO TECLADO
void readKeypad() {

  key = keypad.getKey();

  if (key != NO_KEY) {

    mensagemSenha = "";

    if (systemState == ALARM_STATUS) {
      disarmScreen = true;
    }

    input += key;

    if (input.length() == 4) {

      if (input == CODE) {

        failedAttempts = 0;

        mensagemSenha = "SENHA CORRETA!";
        tempoMensagem = millis();

        // DESARMA O ALARME
        if (systemState == ALARM_STATUS) {

          alarmOff();

          systemState = UNARMED;
          disarmScreen = false;

          portaAberta = false;
        }

        // DESATIVA O SISTEMA
        else if (systemState == ARMED) {

          systemState = UNARMED;

          // ABRE A PORTA POR 5 SEGUNDOS
          portaAberta = true;
          tempoAbertura = millis();
        }

        // ATIVA O SISTEMA
        else {

          systemState = ARMED;
          portaAberta = false;
        }

      }

      else {

        failedAttempts++;

        mensagemSenha = "SENHA INCORRETA!";
        tempoMensagem = millis();

        // ATIVA O ALARME APOS 3 ERROS
        if (failedAttempts >= 3) {

          systemState = ALARM_STATUS;

          disarmScreen = false;
          portaAberta = false;

          alarmOn();
        }
      }

      input = "";
    }
  }
}


// SENSOR PIR E LAMPADA
// SENSOR PIR - CONTROLE DA LAMPADA
// SENSOR PIR - CONTROLE DA LAMPADA
void readPIR() {

  pirState = digitalRead(PIR);

  // DETECTOU MOVIMENTO
  if (pirState == HIGH) {

    digitalWrite(LED_LAMPADA, HIGH);

    tempoMovimento = millis();
  }

  // DESLIGA APOS 5 SEGUNDOS SEM MOVIMENTO
  if (millis() - tempoMovimento >= 5000) {

    digitalWrite(LED_LAMPADA, LOW);
  }
}


// ATUALIZA AS SAIDAS
void updateOutputs() {

  showStatus();

  if (systemState == UNARMED) {

    if (portaAberta) {

      unlockDoor();
      displayColor(0, 255, 0);
    }

    else {

      lockDoor();
      displayColor(255, 0, 0);
    }

    alarmOff();
  }

  else if (systemState == ARMED) {

    lockDoor();
    displayColor(255, 0, 0);

    alarmOff();
  }

  else if (systemState == ALARM_STATUS) {

    lockDoor();
    displayColor(255, 0, 0);

    alarmOn();
  }
}


// LED RGB
void displayColor(int r, int g, int b) {

  analogWrite(RED_LED, r);
  analogWrite(GREEN_LED, g);
  analogWrite(BLUE_LED, b);
}


// TRAVAR A PORTA
void lockDoor() {

  if (ultimaPosicaoServo != LOCKED_POS) {

    servo.write(LOCKED_POS);
    ultimaPosicaoServo = LOCKED_POS;
  }
}


// DESTRAVAR A PORTA
void unlockDoor() {

  if (ultimaPosicaoServo != UNLOCKED_POS) {

    servo.write(UNLOCKED_POS);
    ultimaPosicaoServo = UNLOCKED_POS;
  }
}


// LCD SEM PISCAR
void showStatus() {

  String linha1 = "SENHA: ";

  for (int i = 0; i < input.length(); i++) {
    linha1 += "*";
  }

  String linha2 = "";

  if (mensagemSenha != "") {

    linha2 = mensagemSenha;
  }

  else if (systemState == ALARM_STATUS) {

    if (!disarmScreen) {

      linha2 = "INTRUSO! ALARME";
    }

    else {

      linha2 = "DESARMAR: ";

      for (int i = 0; i < input.length(); i++) {
        linha2 += "*";
      }
    }
  }

  else if (systemState == UNARMED) {

    linha2 = "Status: ABERTO";
  }

  else {

    linha2 = "Status: ATIVADO";
  }

  String telaAtual = linha1 + "|" + linha2;

  // ATUALIZA SOMENTE QUANDO O TEXTO MUDA
  if (telaAtual != ultimaTela) {

    lcd.setCursor(0, 0);
    lcd.print("                ");

    lcd.setCursor(0, 0);
    lcd.print(linha1);

    lcd.setCursor(0, 1);
    lcd.print("                ");

    lcd.setCursor(0, 1);
    lcd.print(linha2);

    ultimaTela = telaAtual;
  }
}


// LIGAR ALARME
void alarmOn() {

  if (millis() - tempoBuzzer >= INTERVALO_BUZZER) {

    tempoBuzzer = millis();

    estadoBuzzer = !estadoBuzzer;

    if (estadoBuzzer) {
      tone(ALARM, 2000);
    }
    else {
      noTone(ALARM);
    }
  }
}


// DESLIGAR ALARME
void alarmOff() {

  noTone(ALARM);

  estadoBuzzer = false;
  tempoBuzzer = millis();
}
